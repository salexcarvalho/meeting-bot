# ---------- Servidor de teste (Dokploy) ----------
# Copie para .env no app do Dokploy. Diferenças em relação ao .env da máquina do Sérgio estão
# marcadas com "VPS:". Gere os segredos com: openssl rand -hex 32
POSTGRES_PASSWORD=troque-por-um-segredo
AGENT_TOKEN=troque-por-32-hex-ou-mais
APP_TIMEZONE=America/Sao_Paulo
# VPS: o Traefik do Dokploy termina o HTTPS e repassa em HTTP; 1 = confia num proxy
TRUST_PROXY=1

# ---------- Privacidade ----------
LOCAL_ONLY=true
# VPS: sem GPU, a transcrição final vai para o Deepgram via OpenRouter
ALLOW_EXTERNAL_ASR=true
ASR_PROVIDER=openrouter
# VPS: ata e ADR pela assinatura do Claude, executada no serviço agent-cli
ALLOW_EXTERNAL_LLM=true
CLAUDE_CLI_ENABLED=true
CLAUDE_CLI_MODEL=sonnet
CODEX_CLI_ENABLED=false
LLM_GENERATION_PROVIDER=claude
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_ASR_MODEL=deepgram/nova-3

# ---------- Reuniões ----------
# VPS: quem grava é o assistente dentro da chamada (o servidor não tem desktop)
AUTO_ASSISTANT=true
AUTO_LOCAL_RECORDING=false
# VPS: sem worker local não há passe ao vivo (o ao vivo é sempre local, constituição 1.1.0)
BOT_LIVE_TRANSCRIPTION=false
BOT_CAMERA=false
MAX_CONCURRENT_BOTS=2
ADMISSION_TIMEOUT_MINUTES=10
MAX_MEETING_MINUTES=240
ALONE_TIMEOUT_MINUTES=5
# Dono das reuniões que a assinatura pode gerar (usuário criado no servidor)
AGENT_OWNER=sergio
