{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "resumo_trecho": {
      "type": "string",
      "maxLength": 600
    },
    "itens": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "decisao",
              "decisao_arquitetural",
              "pendencia",
              "risco",
              "requisito_funcional",
              "requisito_nao_funcional",
              "regra_negocio",
              "restricao",
              "premissa",
              "pergunta_aberta",
              "debito_tecnico"
            ]
          },
          "descricao": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "segmentos": {
            "minItems": 1,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 12
            }
          },
          "citacao": {
            "type": "string",
            "maxLength": 400
          },
          "responsavel": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "prazo": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "dependencia": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ]
          },
          "motivacao": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "impacto": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "sistema": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "categoria": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "arquitetura",
                  "seguranca",
                  "infraestrutura",
                  "prazo",
                  "integracao",
                  "dados",
                  "performance",
                  "escalabilidade",
                  "governanca"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "tipo",
          "descricao",
          "segmentos",
          "citacao",
          "responsavel",
          "prazo",
          "dependencia",
          "motivacao",
          "impacto",
          "sistema",
          "categoria"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "resumo_trecho",
    "itens"
  ],
  "additionalProperties": false
}
