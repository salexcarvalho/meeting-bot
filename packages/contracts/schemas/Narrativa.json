{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "objetivo": {
      "type": "string",
      "maxLength": 600
    },
    "resumo_executivo": {
      "type": "string",
      "maxLength": 1200
    },
    "assuntos": {
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string",
            "maxLength": 200
          },
          "resumo": {
            "type": "string",
            "maxLength": 800
          }
        },
        "required": [
          "titulo",
          "resumo"
        ],
        "additionalProperties": false
      }
    },
    "observacoes_arquiteto": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 600
      }
    }
  },
  "required": [
    "objetivo",
    "resumo_executivo",
    "assuntos",
    "observacoes_arquiteto"
  ],
  "additionalProperties": false
}
