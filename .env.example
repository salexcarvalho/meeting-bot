# ---------- Privacidade ----------
# Único modo suportado: nenhum áudio/texto sai da máquina; LLM só local.
LOCAL_ONLY=true
# Hosts que o backend pode acessar via fetch (o resto é bloqueado e auditado).
EGRESS_ALLOWLIST=ollama,worker-gpu,localhost,127.0.0.1

# ---------- Banco ----------
# Use só letras e números (vai dentro de uma URL de conexão).
POSTGRES_PASSWORD=troque-esta-senha

# ---------- Você ----------
# Padrão do nome do canal do microfone. Cada usuário ajusta o próprio em Configurações > Perfil.
USER_DISPLAY_NAME=Sérgio
APP_TIMEZONE=America/Sao_Paulo

# ---------- host-agent ----------
# Segredo local compartilhado entre o backend e o host-agent (alertas e captura).
# Gere com: openssl rand -hex 32
AGENT_TOKEN=
# Usuário (login) dono desta máquina: só as reuniões dele são gravadas pelo host-agent.
# Vazio = o primeiro usuário cadastrado, se ainda for SUPER_ADMIN ativo (defina quando houver mais de um usuário).
AGENT_OWNER=

# ---------- GPU ----------
# worker-gpu e Ollama na GPU NVIDIA (Docker Engine nativo + scripts/setup-host.sh)
COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# ---------- Transcrição (worker-gpu, faster-whisper) ----------
# large-v3-turbo int8_float16: ~1,4 GB de VRAM, 58 s de áudio em ~1 s (RTX 4050)
ASR_MODEL=large-v3-turbo
ASR_COMPUTE_TYPE=int8_float16
TRANSCRIPTION_LANGUAGE=pt

# Separação de falantes (pyannote/speaker-diarization-community-1).
# Aceite os termos em https://huggingface.co/pyannote/speaker-diarization-community-1
# e crie um token (leitura) em https://huggingface.co/settings/tokens.
# Sem token, os demais participantes aparecem como "Remoto".
HF_TOKEN=

# ---------- ASR externo de teste (opcional, Constituição 1.1.0) ----------
# ATENÇÃO: com ALLOW_EXTERNAL_ASR=true o ÁUDIO da reunião pode ser enviado ao OpenRouter
# (Deepgram nova-3). Só no passe final e em uploads, nunca ao vivo; o LLM continua local.
# Use apenas com áudio que a política da organização permite enviar para terceiros.
ALLOW_EXTERNAL_ASR=false
# Padrão do passe final/uploads: local (Whisper) ou openrouter. Por reunião dá para escolher
# no upload e em "Reprocessar".
ASR_PROVIDER=local
# Chave em https://openrouter.ai/settings/keys (a mesma serve para o LLM externo abaixo)
OPENROUTER_API_KEY=
OPENROUTER_STT_MODEL=deepgram/nova-3

# ---------- LLM externo para ata e ADR (opcional, Constituição 1.3.0) ----------
# ATENÇÃO: com ALLOW_EXTERNAL_LLM=true a TRANSCRIÇÃO da reunião pode ser enviada ao OpenRouter
# para gerar ata e ADRs. A análise ao vivo é sempre local. Use apenas com conteúdo que a
# política da organização permite enviar para terceiros.
ALLOW_EXTERNAL_LLM=false
# Onde roda a análise automática pós-reunião: local (Ollama), openrouter, claude ou codex.
# Os botões "Gerar ata" e "Gerar ADR" perguntam a cada clique.
LLM_GENERATION_PROVIDER=local
# Qualquer modelo do OpenRouter com structured outputs
OPENROUTER_LLM_MODEL=anthropic/claude-sonnet-5
OPENROUTER_LLM_TIMEOUT_SECONDS=180
# modelos que raciocinam antes de responder (ex.: DeepSeek) gastam parte deste limite
OPENROUTER_LLM_MAX_TOKENS=32000

# ---------- Assinatura pessoal: Claude Code / Codex (opcional, Constituição 1.4.0) ----------
# Exige ALLOW_EXTERNAL_LLM=true. Quem executa é o host-agent, com o CLI e o login do dono da
# máquina (AGENT_OWNER); vale só para as reuniões dele. Plano pessoal segue os termos de
# consumidor: confira na sua conta se as conversas podem ser usadas para treino.
# LLM_GENERATION_PROVIDER aceita também claude ou codex. Sem host-agent pronto, a análise
# automática espera até SUBSCRIPTION_WAIT_MINUTES; se não voltar, a reunião fica com erro
# (a ata sai pelo botão "Gerar ata"). Não troca para o modelo local.
SUBSCRIPTION_WAIT_MINUTES=30
CLAUDE_CLI_ENABLED=false
CLAUDE_CLI_MODEL=sonnet
CODEX_CLI_ENABLED=false
# vazio = modelo padrão do Codex
CODEX_CLI_MODEL=
SUBSCRIPTION_LLM_TIMEOUT_SECONDS=600

# ---------- Agente arquiteto (Ollama local) ----------
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_KEEP_ALIVE=30m
# Janela de extração ao vivo: a cada N s de fala nova (ou no máximo a cada M s)
LIVE_EXTRACT_MIN_SPEECH_SECONDS=90
LIVE_EXTRACT_MAX_INTERVAL_SECONDS=180
LIVE_CONSOLIDATE_INTERVAL_SECONDS=900

# ---------- Modo Agente (bot convidado) ----------
# O nome do bot vem do perfil de cada usuário (Meu nome / Nome do agente / Personalizado), sem
# sufixo. O nome precisa dizer que é a ata (Constituição, princípio II): sem "ata", "gravação" ou
# "transcrição", entra como "Ata de <nome>". Teams só aceita letras, números, espaço e - ' . _ @
# Nome do agente para quem ainda não configurou o seu
DEFAULT_AGENT_NAME=Assistente
# Usado só em reuniões sem dono (usuário removido)
BOT_DISPLAY_NAME="Ata Bot"
# Prazo total para chegar ao pedido de entrada (tela de pré-entrada)
BOT_JOIN_TIMEOUT_SECONDS=45
# Reunião sem horário previsto: silêncio que faz o assistente sair
BOT_SILENCE_STOP_MINUTES=10
# Câmera virtual mostrando só o avatar do agente, parado (vira um quadro de vídeo na chamada)
BOT_CAMERA=false
# Transcrição ao vivo do áudio que o assistente grava na chamada
BOT_LIVE_TRANSCRIPTION=true
ADMISSION_TIMEOUT_MINUTES=10
MAX_MEETING_MINUTES=240
ALONE_TIMEOUT_MINUTES=5
MAX_CONCURRENT_BOTS=2
# No horário, o assistente entra nas reuniões da agenda com link do Teams/Meet (exceto "Não gravar")
AUTO_ASSISTANT=true
# O computador grava sozinho no horário (desligado: grava só o assistente, de dentro da chamada)
AUTO_LOCAL_RECORDING=false
MAX_UPLOAD_MB=500

# ---------- Perfis ----------
# Fotos (usuário e agente) e gravação de voz do agente, guardadas em DATA_DIR/profiles
MAX_AVATAR_KB=2048
MAX_VOICE_KB=4096
MAX_VOICE_SECONDS=60

# ---------- Acesso web ----------
# 127.0.0.1 = só nesta máquina. Em rede, use o profile https abaixo.
BIND_ADDRESS=127.0.0.1
HOST_PORT=3000
SESSION_TTL_HOURS=168

# HTTPS com Caddy (docker compose --profile https up -d):
# DOMAIN=ata.suaempresa.com.br
# COOKIE_SECURE=true
# TRUST_PROXY=1
COOKIE_SECURE=false
TRUST_PROXY=
